# Database MySQL
# In locale usa localhost:3307; dentro Docker l'app usa db:3306 (lo imposta docker-compose.yml)
MYSQL_ROOT_PASSWORD=cambia_questa_root
MYSQL_DATABASE=mensasave
MYSQL_USER=mensa_user
MYSQL_PASSWORD=cambia_questa_password
MYSQL_HOST=localhost
MYSQL_PORT=3307


# LLM API Key (scegli uno dei seguenti)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b
GOOGLE_API_KEY=your_google_key_here
OPENAI_API_KEY=your_openai_key_here

# Streamlit
STREAMLIT_SERVER_PORT=8501